{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: debug",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "${workspaceFolder}\\build.bat", "-p", "debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build: release",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "${workspaceFolder}\\build.bat", "-p", "release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": "build"
    }
  ]
}
