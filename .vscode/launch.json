{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Menu",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/debug/dnd.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${env:PATH};C:\\msys64\\ucrt64\\bin"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build: debug"
    },
    {
      "name": "Debug DM (host)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/debug/dnd.exe",
      "args": ["--host"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${env:PATH};C:\\msys64\\ucrt64\\bin"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build: debug"
    },
    {
      "name": "Debug DM (host, no build)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/debug/dnd.exe",
      "args": ["--host"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${env:PATH};C:\\msys64\\ucrt64\\bin"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug Player (client)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/debug/dnd.exe",
      "args": ["--connect", "127.0.0.1:7777", "--name", "player"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${env:PATH};C:\\msys64\\ucrt64\\bin"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "compounds": [
    {
      "name": "Debug DM + Player",
      "configurations": ["Debug DM (host, no build)", "Debug Player (client)"],
      "preLaunchTask": "build: debug",
      "stopAll": true
    }
  ]
}
