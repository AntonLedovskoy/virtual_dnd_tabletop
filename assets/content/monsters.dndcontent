# Бестиарий игры. Формат: format = 1, секции [monster id], поля ключ = значение.
# Файл читается хостом, клиентом и редактором при запуске; правьте копию в
# assets/content/local/monsters.dndcontent, чтобы обновление её не заменило.
format = 1

[monster goblin]
name = Гоблин
ac = 15
hit_die = d6
con = 0
hit_dice = 2
speed = 9
attack = 4
damage = 1d6+2 рубящий
notes = Скимитар: +4, 1d6+2; короткий лук: +4, 1d6+2

